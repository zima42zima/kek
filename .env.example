# Copy this file to .env and fill in values from Supabase → Project Settings → API
# Use the Publishable key (sb_publishable_...) — NOT the secret key
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Optional: enables GIF search in posts. Get a free key at
# https://developers.giphy.com (create an app → copy the API key).
# Without it, emojis still work and you can paste a GIF URL manually.
VITE_GIPHY_KEY=

# Optional: better map tiles for Echo Map (pick one — free tiers available)
# MapTiler: https://cloud.maptiler.com/account/keys
# VITE_MAPTILER_KEY=
# Mapbox: https://account.mapbox.com/access-tokens
# VITE_MAPBOX_TOKEN=
# Default without keys: CARTO Voyager (labeled streets, free, no signup)
# OpenStreetMap.org tiles are not used — their public server blocks most apps.
